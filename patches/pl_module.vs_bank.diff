+    def _bank_loss(self, pred, true, step_name):
+        """Train-only: rank against batch targets + a bank of seen training-image embeddings."""
+        import os
+        import torch
+        import torch.nn.functional as F
+        loss = self.loss
+        if (step_name != "train" or os.environ.get("NB_BANK") != "1"
+                or not hasattr(loss, "get_scores") or true.ndim != 2 or pred.shape != true.shape):
+            return loss(pred, true)
+        thr = 0.9999
+        with torch.no_grad():
+            t = true.detach()
+            tn = F.normalize(t.float(), dim=1)
+            if getattr(self, "_nb_bank", None) is None:
+                self._nb_bank, self._nb_bank_n, self._nb_step = t[:0].clone(), tn[:0].clone(), 0
+                print("[NB_BANK] bank negatives ON", flush=True)
+            keep = ~(torch.tril(tn @ tn.T, -1) > thr).any(1)
+            if len(self._nb_bank_n):
+                keep &= ~((tn @ self._nb_bank_n.T).max(1).values > thr)
+            if keep.any():
+                self._nb_bank = torch.cat([self._nb_bank, t[keep]], 0)
+                self._nb_bank_n = torch.cat([self._nb_bank_n, tn[keep]], 0)
+            dup = (self._nb_bank_n @ tn.T).max(1).values > thr
+            self._nb_step += 1
+            if self._nb_step % 2000 == 1:
+                print(f"[NB_BANK] step {self._nb_step} bank size {len(self._nb_bank)}", flush=True)
+        B = len(true)
+        cand = torch.cat([true, self._nb_bank.to(true.dtype)], 0)
+        scores = loss.get_scores(pred, cand)
+        mask = torch.cat([torch.zeros(B, dtype=torch.bool, device=dup.device), dup])
+        scores = scores.masked_fill(mask[None, :], float("-inf"))
+        tgt = torch.arange(B, device=pred.device)
+        out = F.cross_entropy(scores, tgt, reduction=loss.reduction)
+        if getattr(loss, "symmetric", False):
+            out_c = F.cross_entropy(scores[:, :B].transpose(0, 1), tgt, reduction=loss.reduction)
+            out = (out + out_c) / 2
+        return out
+
+    def _p2_or_bank(self, pred, true, step_name):
+        import os
+        G = int(os.environ.get("NB_GROUP", "0") or 0)
+        if (G < 1 or step_name != "train" or not hasattr(self.loss, "get_scores")
+                or true.ndim != 2 or pred.shape != true.shape):
+            return self._bank_loss(pred, true, step_name)
+        from neuralbench.p2 import p2_loss
+        if not getattr(self, "_p2_said", False):
+            print(f"[P2] loss ON G={G} lambda={os.environ.get('NB_LAMBDA','1.0')} group_loss={os.environ.get('NB_GROUP_LOSS','1')}", flush=True)
+            self._p2_said = True
+        return p2_loss(self.loss, pred, true, G, float(os.environ.get("NB_LAMBDA", "1.0")),
+                       group_on=os.environ.get("NB_GROUP_LOSS", "1") == "1")
+
+    def _aux_add(self, loss, true, step_name):
+        import os
+        if (os.environ.get("NB_AUX") != "1" or step_name != "train"
+                or not hasattr(self.model, "aux_head") or isinstance(loss, dict)):
+            return loss
+        import numpy as np
+        import torch
+        import torch.nn.functional as F
+        dev = true.device
+        if getattr(self, "_aux_tab", None) is None:
+            z = np.load(os.environ["NB_AUX_NPZ"])
+            names = os.environ.get("NB_AUX_LAYERS", "L20,L24,L28,L32,L36").split(",")
+            self._aux_cands = {k: F.normalize(torch.tensor(z[k].astype("float32")), dim=1)
+                               for k in z.files if k.startswith("L")}
+            tabs = []
+            for k in names:
+                a = torch.tensor(z[k].astype("float32"))
+                tabs.append((a - a.mean(0)) / (a.std(0) + 1e-6))
+            self._aux_tab = torch.stack(tabs, 1).to(dev)
+            self._aux_key = os.environ.get("NB_AUX_MATCH", "L26")
+            self._aux_n = 0
+        tn = F.normalize(true.detach().float(), dim=1)
+        if self._aux_n == 0:
+            MG = float(os.environ.get("NB_AUX_MARGIN", "0.02")); tc = tn.cpu(); st = {}
+            for k, v in self._aux_cands.items():
+                t2 = (tc @ v.T).topk(2, dim=1).values
+                m = t2[:, 0]; g = t2[:, 0] - t2[:, 1]
+                st[k] = (round(m.mean().item(), 4), round(m.min().item(), 4), round((g > MG).float().mean().item(), 3), round(g.median().item(), 4))
+            print("[NB_AUX] match (mean cos, min cos, frac margin>MG, median margin):", st, flush=True)
+            best = max(st, key=lambda k: (st[k][2], st[k][0]))
+            self._aux_key = os.environ.get("NB_AUX_MATCH") or best
+            assert st[self._aux_key][2] >= 0.9, f"NB_AUX: no layer matches: {st}"
+            self._aux_cands = {self._aux_key: self._aux_cands[self._aux_key].to(dev)}
+            print("[NB_AUX] using", self._aux_key, flush=True)
+        t2v, t2i = (tn @ self._aux_cands[self._aux_key].T).topk(2, dim=1)
+        idx = t2i[:, 0]
+        ok = ((t2v[:, 0] - t2v[:, 1]) > float(os.environ.get("NB_AUX_MARGIN", "0.02"))).float()
+        emb = self.model._last_emb
+        K = self._aux_tab.shape[1]
+        pred = self.model.aux_head(emb).view(len(emb), K, -1)
+        cs = F.cosine_similarity(pred, self._aux_tab[idx], dim=-1).mean(1)
+        la = ((1 - cs) * ok).sum() / ok.sum().clamp(min=1.0)
+        self._aux_n += 1
+        if self._aux_n % 500 == 1:
+            print(f"[NB_AUX] step {self._aux_n} aux {la.item():.4f} main {loss.item():.4f} ok {ok.mean().item():.3f}", flush=True)
+        return loss + float(os.environ.get("NB_AUX_LAMBDA", "1.0")) * la
+
     def training_step(self, batch: Batch, batch_idx: int):
         loss, _, _ = self._run_step(batch, step_name="train", batch_idx=batch_idx)
